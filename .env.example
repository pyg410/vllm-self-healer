# Required: a vLLM-compatible chat model with a chat template.
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Pin a version/digest validated for your GPU in production.
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_BASE_URL=http://vllm:8000
VLLM_CONTAINER_NAME=vllm
VLLM_API_KEY=
PROBE_PROMPT=ping
PROBE_MAX_TOKENS=1
CHECK_INTERVAL=30
HEALTH_TIMEOUT=5
INFERENCE_TIMEOUT=15
FAILURE_THRESHOLD=3
STARTUP_GRACE_PERIOD=300
RECOVERY_CHECK_INTERVAL=10
RECOVERY_TIMEOUT=600
RESTART_COOLDOWN=300
RESTART_WINDOW=600
MAX_RESTARTS=3
DOCKER_STOP_TIMEOUT=30
DOCKER_API_TIMEOUT=60
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT=5
STATE_FILE=/data/watchdog_state.json
LOG_LEVEL=INFO
LOG_TIMEZONE=UTC
# Linux: replace with 'stat -c %g /var/run/docker.sock'.
DOCKER_SOCKET_GID=0

# Default mode preserves existing Docker/Compose behavior.
RECOVERY_MODE=docker
# Kubernetes mode only; vLLM startup wrapper writes a unique ID per execution.
WATCHDOG_HTTP_HOST=0.0.0.0
WATCHDOG_HTTP_PORT=9090
VLLM_START_ID_FILE=/run/vllm-watchdog/start-id
KUBERNETES_RESTART_TIMEOUT=120

# Optional application log rotation (stdout remains enabled).
# /logs must exist and be writable by UID/GID 10001.
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Informational lifecycle notifications, separate from legacy ALERT_WEBHOOK_URL.
# Empty event filter means all supported events; comma-separated names otherwise.
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_METHOD=POST
EVENT_WEBHOOK_TIMEOUT=5
EVENT_WEBHOOK_EVENTS=
EVENT_WEBHOOK_HEADERS={}
EVENT_WEBHOOK_BODY={}

# Optional actions: e.g. external drain/ready APIs. No shell commands.
PRE_RESTART_WEBHOOK_URL=
PRE_RESTART_WEBHOOK_METHOD=POST
PRE_RESTART_WEBHOOK_TIMEOUT=10
PRE_RESTART_WEBHOOK_HEADERS={}
PRE_RESTART_WEBHOOK_BODY={}
PRE_RESTART_WEBHOOK_FAILURE_POLICY=continue
POST_RECOVERY_WEBHOOK_URL=
POST_RECOVERY_WEBHOOK_METHOD=POST
POST_RECOVERY_WEBHOOK_TIMEOUT=10
POST_RECOVERY_WEBHOOK_HEADERS={}
POST_RECOVERY_WEBHOOK_BODY={}
POST_RECOVERY_WEBHOOK_FAILURE_POLICY=continue
